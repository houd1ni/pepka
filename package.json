{
  "author": {
    "name": "Michael houd1ni Akiliev"
  },
  "bugs": {
    "url": "https://github.com/houd1ni/pepka/issues"
  },
  "deprecated": false,
  "description": "An ultra lightweight, async or unsafe-speedy ramda alternative.",
  "homepage": "https://houd1ni.github.io/pepka/",
  "keywords": [
    "ramda",
    "functional",
    "fp",
    "toolkit",
    "pure",
    "strongly-typed",
    "typescript",
    "d.ts"
  ],
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/bundle.mjs",
      "require": "./dist/bundle.cjs"
    }
  },
  "name": "pepka",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/houd1ni/pepka.git"
  },
  "scripts": {
    "lint": "eslint src --ext ts",
    "type-check": "tsgo --noEmit --noUnusedLocals --noUnusedParameters && tsgo --noEmit --strict --module esnext --moduleResolution bundler --types node --ignoreConfig tests/types/*.test.ts tests/pepka.spec.ts",
    "test": "tsx node_modules/uvu/bin.js tests spec",
    "gentypes": "tsx scripts/gentypes.ts",
    "dev": "tsx scripts/build.ts dev",
    "build": "tsx scripts/build.ts esm",
    "build:cjs": "tsx scripts/build.ts cjs",
    "prod": "pnpm build && pnpm build:cjs && pnpm gentypes",
    "all": "pnpm dev && pnpm prod",
    "watch": "nodemon --watch src --ext ts,js --exec \"pnpm run dev\""
  },
  "version": "1.14.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.9.1",
    "jiti": "^2.7.0",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "uvu": "^0.5.6"
  },
  "packageManager": "pnpm@11.17.0",
  "sideEffects": false
}