{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "lib": [ "esnext", "DOM" ],
    "types": [ "node" ],
    "strictNullChecks": true,
    "target": "esnext",
    "module": "esnext",
    "allowJs": false,
    "sourceMap": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "noUnusedParameters": true,
    "noUnusedLocals": false,
    "rootDir": ".",
    "outDir": "dist/ts"
  },
  "include": [ "scripts/**/*", "src/**/*", "types/**/*" ]
}